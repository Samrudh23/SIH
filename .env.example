# ==============================================================================
# SIH26034 — Packaged Commodity Compliance Scanner
# Production & Deployment Environment Configuration Template
# ==============================================================================

# Application Environment: development | staging | production
APP_ENV=production

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# Debug mode (MUST be false in production)
DEBUG=false

# Worker processes for Uvicorn (recommended: 2-4 for production containers)
WEB_CONCURRENCY=2

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Default: Persistent SQLite database file.
# For Cloud PaaS / Containers, mount a persistent volume (e.g., /data/sih26034.db)
# Or provide a PostgreSQL connection URI:
# DATABASE_URL=postgresql://user:password@hostname:5432/sih26034
DATABASE_URL=sqlite:///./sih26034.db

# ------------------------------------------------------------------------------
# Storage Configuration
# ------------------------------------------------------------------------------
# Directory for storing uploaded package evidence images.
# For Cloud PaaS / Containers, point to persistent mount (e.g., /data/uploads)
UPLOAD_DIR=./uploads

# Maximum allowed file upload size in bytes (default: 10MB)
MAX_FILE_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# Security & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for cross-origin frontend access.
# If frontend is served same-origin via SERVE_FRONTEND=true, CORS is not required.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Frontend Integration
# ------------------------------------------------------------------------------
# When true, FastAPI directly serves the Inspector Portal static frontend at /
# providing unified single-port hosting with zero CORS complexity.
SERVE_FRONTEND=true
FRONTEND_DIR=./frontend

# Frontend API base URL (used when building/running decoupled frontend)
API_BASE_URL=/api

# Compliance Engine Type: "real" (rule engine + OCR) or "mock" (fixtures)
COMPLIANCE_ENGINE_TYPE=real
